# =====================================================================
# cPanel MySQL Veritabanı Bağlantısı (E-Ticaret & B2B ERP Uyumlu)
# Biçim: mysql://KULLANICI:SIFRE@localhost:3306/VERITABANI_ADI
# Örnek: mysql://ata3a6icilikcom_pekefeuser:Sifreniz123!@localhost:3306/ata3a6icilikcom_pekefe
