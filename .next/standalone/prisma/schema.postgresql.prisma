generator client {
  provider = "prisma-client-js"
  output   = "../src/generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  isApproved    Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  roles     UserRole[]

  @@index([isDeleted])
  @@index([role])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  addressTitle String
  firstName    String
  lastName     String
  phone        String
  city         String
  district     String
  fullAddress  String
  isDefault    Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  sku              String   @unique
  category         String
  subCategory      String?
  stock            Float    @default(0)
  criticalLimit    Float    @default(0)
  price            Decimal  @default(0.0) @db.Decimal(18, 4)
  oldPrice         Decimal? @db.Decimal(18, 4)
  isCampaignActive Boolean  @default(false)
  cartDiscountRate Float    @default(0)
  cost             Decimal  @default(0.0) @db.Decimal(18, 4)
  image            String?
  images           Json
  desc             String?  @db.Text
  seoTitle         String?
  seoDesc          String?
  seoKeywords      String?
  videoUrl         String?
  attributes       Json
  isRawMaterial    Boolean  @default(false)
  rating           Float    @default(5.0)
  reviews          Int      @default(0)
  isDeleted        Boolean  @default(false)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants          ProductVariant[]
  usedInRecipes     RecipeItem[]      @relation("Ingredient")
  recipe            RecipeItem[]      @relation("MainProduct")
  locations         StockLocation[]
  stockTransactions StockTransaction[]
  stockTransfers    StockTransfer[]
  despatchLines     DespatchLine[]

  @@index([category])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([sku])
}

model CategoryDetail {
  id         String  @id @default(cuid())
  name       String  @unique
  parentId   String?
  attributes Json
  variants   Json

  @@index([parentId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  attributes Json
  stock      Float    @default(0)
  price      Decimal? @db.Decimal(18, 4)
  sku        String   @unique
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
}

model StockLocation {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  stock       Float     @default(0)
  rack        String?
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouseId])
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String
  type      String
  address   String?         @db.Text
  locations StockLocation[]
}

model RecipeItem {
  id            String  @id @default(cuid())
  mainProductId String
  ingredientId  String
  quantity      Float
  unit          String
  ingredient    Product @relation("Ingredient", fields: [ingredientId], references: [id], onDelete: Cascade)
  mainProduct   Product @relation("MainProduct", fields: [mainProductId], references: [id], onDelete: Cascade)

  @@index([mainProductId])
  @@index([ingredientId])
}

model ProductionOrder {
  id        String   @id @default(cuid())
  productId String
  quantity  Float
  status    String
  date      DateTime @default(now())

  @@index([productId])
  @@index([status])
}

model CurrentAccount {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("MUSTERI")
  taxNo          String?
  taxId          String?
  taxOffice      String?
  phone          String?
  email          String?  @unique
  address        String?  @db.Text
  balance        Decimal  @default(0.0) @db.Decimal(18, 4)
  currency       String   @default("TRY")
  openingBalance Decimal  @default(0.0) @db.Decimal(18, 4)
  isActive       Boolean  @default(true)
  isDeleted      Boolean  @default(false)
  discountRate   Float?
  creditLimit    Decimal? @db.Decimal(18, 4)
  riskLimit      Decimal? @db.Decimal(18, 4)
  vadeGun        Int?
  b2bMinQty      Float?   @default(1)
  b2bPaymentTerms String?  @default("Nakit")
  b2bCode        String?
  loyaltyPoints  Float    @default(0)
  dealerGroup    String   @default("Standart")
  priceGroup     String   @default("Liste")
  priceFormula   String?
  parentDealerId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices     Invoice[]
  orders       Order[]
  subAccounts  SubAccount[]
  transactions Transaction[]
  despatchAdvices DespatchAdvice[]

  @@index([type])
  @@index([isActive])
  @@index([isDeleted])
  @@index([parentDealerId])
}

model SubAccount {
  id               String         @id @default(cuid())
  currentAccountId String
  name             String
  email            String         @unique
  phone            String?
  role             String
  balance          Decimal        @default(0.0) @db.Decimal(18, 4)
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id], onDelete: Cascade)

  @@index([currentAccountId])
}

model Transaction {
  id               String         @id @default(cuid())
  currentAccountId String
  subAccountId     String?
  date             DateTime       @default(now())
  type             String
  amount           Decimal        @db.Decimal(18, 4)
  description      String         @db.Text
  paymentMethod    String?
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id], onDelete: Cascade)

  @@index([currentAccountId])
  @@index([date])
}

model Invoice {
  id               String         @id @default(cuid())
  orderId          String?
  currentAccountId String
  date             DateTime       @default(now())
  dueDate          DateTime
  totalAmount      Decimal        @db.Decimal(18, 4)
  taxAmount        Decimal        @db.Decimal(18, 4)
  status           String
  type             String
  externalLink     String?
  items            Json
  notes            String?        @db.Text
  isDeleted        Boolean        @default(false)
  stockMovement    Boolean        @default(false) @map("stock_movement")
  invoiceItems     InvoiceItem[]
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id], onDelete: Cascade)
  despatchAdvices  DespatchAdvice[]

  @@index([currentAccountId])
  @@index([status])
  @@index([date])
  @@index([isDeleted])
}

model Bank {
  id            String  @id @default(cuid())
  name          String
  accountNumber String
  iban          String
  balance       Decimal @default(0.0) @db.Decimal(18, 4)
  currency      String  @default("TRY")
  logo          String?
  branch        String?
  type          String  @default("VADESIZ")
}

model Order {
  id               String         @id @default(cuid())
  currentAccountId String
  date             DateTime       @default(now())
  status           String
  total            Decimal        @db.Decimal(18, 4)
  summary          String?        @db.Text
  type             String         @default("B2C")
  method           String?
  isDeleted        Boolean        @default(false)
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([date])
  @@index([currentAccountId])
  @@index([isDeleted])
}

model CMSData {
  id                       String  @id @default("singleton")
  heroTitle                String
  heroSubtitle             String
  buttonText               String
  announcement             String
  announcement2            String  @default("🔥 %100 Yerli İmalat Paslanmaz Arı Körükleri ve Ekipmanları")
  maintenanceMode          Boolean @default(false)
  siteName                 String  @default("PEKEFE Geleneksel & Doğal Lezzetler")
  primaryColor             String  @default("#b45309")
  secondaryColor           String  @default("#1F2937")
  siteDescription          String  @default("")
  categoryTitle            String  @default("")
  categorySubtitle         String  @default("")
  appTitle                 String  @default("")
  appSubtitle              String  @default("")
  contactPhone             String  @default("")
  contactEmail             String  @default("")
  contactAddress           String  @default("")
  socialInstagram          String  @default("")
  socialWhatsapp           String  @default("")
  logoFont                 String  @default("Outfit")
  logoUrl                  String  @default("")
  logoSize                 Int     @default(18)
  logoWeight               String  @default("font-black")
  footerSlogan             String  @default("FABRİKADAN DİREKT")
  borderRadius             Int     @default(12)
  announcementActive       Boolean @default(true)
  announcementSpeed        Int     @default(15)
  layoutWidth              String  @default("max-w-4xl")
  heroAlignment            String  @default("center")
  pricingRules             Json
  shippingThreshold        Float   @default(5000)
  shippingFee              Float   @default(150)
  shippingCarriers         Json
  themeTemplates           Json
  contentAnywhereRules     Json
  savedSectionTemplates    Json
  popupConfig              Json
  topBarText1              String  @default("Türkiye'nin Her Yerine Güvenli Sevkiyat")
  topBarText2              String  @default("304 Paslanmaz Çelik ve Dayanıklı Tasarım")
  faqData                  Json
  cartDiscountType         String  @default("none")
  cartDiscountValue        Float   @default(0)
  cartDiscountMinAmount    Float   @default(0)
  bankTransferDiscountRate Float   @default(0)
  companyName              String  @default("")
  bankName                 String  @default("")
  bankIban                 String  @default("")
}

model CMSPage {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Integration {
  id       String  @id @default(cuid())
  name     String
  type     String
  status   String
  lastSync String?
  logo     String
  settings Json
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String
  time          String
  message       String
  status        String
  createdAt     DateTime @default(now())

  @@index([integrationId])
}

model StockTransaction {
  id          String   @id @default(cuid())
  productId   String
  type        String
  quantity    Float
  description String?  @db.Text
  date        DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([date])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Float
  minCartAmount Float     @default(0)
  maxUses       Int?
  uses          Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([code])
}

model Ticket {
  id        String   @id @default(cuid())
  email     String
  subject   String
  status    String   @default("OPEN")
  category  String   @default("GENERAL")
  orderId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  sender    String
  message   String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        String   @default("percentage")
  value       Float    @default(0)
  minOrder    Float    @default(0)
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  startDate   String
  endDate     String
  isActive    Boolean  @default(true)
  target      String   @default("all")
  description String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model StockTransfer {
  id              String   @id @default(cuid())
  productId       String
  fromWarehouseId String
  toWarehouseId   String
  quantity        Float
  status          String   @default("Bekliyor")
  requester       String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  rating    Int
  message   String   @db.Text
  status    String   @default("PENDING")
  reply     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  category  String   @default("Genel")
  image     String?
  metaDesc  String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model AccountingAccount {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  type       String
  parentCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")

  @@index([code])
}

model JournalEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  number      String   @unique
  description String   @db.Text
  status      String   @default("DRAFT")
  type        String   @default("GENERAL")
  createdBy   String?
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines JournalLine[]

  @@index([status])
  @@index([date])
  @@index([number])
}

model JournalLine {
  id             String            @id @default(cuid())
  journalEntryId String
  debitAccountId String
  creditAccountId String
  amount         Decimal           @db.Decimal(18, 4)
  description    String?           @db.Text
  journalEntry   JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  debitAccount   AccountingAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount  AccountingAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([journalEntryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

model Expense {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  category      String
  amount        Decimal  @db.Decimal(18, 4)
  taxAmount     Decimal  @default(0.0) @db.Decimal(18, 4)
  description   String   @db.Text
  supplier      String?
  receiptNo     String?
  paymentMethod String   @default("NAKIT")
  bankId        String?
  status        String   @default("ODENDI")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model BudgetItem {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  category  String
  planned   Decimal  @db.Decimal(18, 4)
  actual    Decimal  @default(0.0) @db.Decimal(18, 4)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, category])
}

model TaxDeclaration {
  id        String    @id @default(cuid())
  period    String
  type      String
  amount    Decimal   @db.Decimal(18, 4)
  taxBase   Decimal?  @db.Decimal(18, 4)
  taxRate   Float?
  status    String    @default("BEKLIYOR")
  dueDate   DateTime
  paidDate  DateTime?
  paidAt    DateTime?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([period])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  name        String
  quantity    Float
  unitPrice   Decimal  @db.Decimal(18, 4)
  vatRate     Float    @default(18)
  totalAmount Decimal  @db.Decimal(18, 4)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Income {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  category         String
  amount           Decimal  @db.Decimal(18, 4)
  taxAmount        Decimal  @default(0.0) @db.Decimal(18, 4)
  description      String   @db.Text
  currentAccountId String?
  paymentMethod    String   @default("HAVALE")
  bankId           String?
  status           String   @default("ALINDI")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model AuthLog {
  id         String   @id @default(cuid())
  ip         String
  userId     String?
  route      String
  method     String
  failReason String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model DespatchAdvice {
  id                 String         @id @default(uuid()) @map("despatch_id")
  despatchNo         String         @unique @map("despatch_no")
  ettnNo             String         @unique @default(uuid()) @map("ettn_no")
  customerAccountId  String         @map("customer_id")
  invoiceId          String?        @map("invoice_id")
  issueDate          DateTime       @map("issue_date")
  actualDespatchDate DateTime       @map("actual_despatch_date")
  carrierId          String?        @map("carrier_id")
  driverName         String?        @map("driver_name")
  driverIdentityNo   String?        @map("driver_identity_no")
  licensePlate       String?        @map("license_plate")
  status             String         @map("status")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  customerAccount    CurrentAccount @relation(fields: [customerAccountId], references: [id])
  invoice            Invoice?       @relation(fields: [invoiceId], references: [id])
  lines              DespatchLine[]

  @@map("despatch_advices")
  @@index([customerAccountId])
  @@index([invoiceId])
}

model DespatchLine {
  id               String         @id @default(uuid()) @map("line_id")
  despatchId       String         @map("despatch_id")
  productId        String         @map("stock_id")
  quantity         Float          @map("quantity")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  despatchAdvice   DespatchAdvice @relation(fields: [despatchId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])

  @@map("despatch_lines")
  @@index([despatchId])
  @@index([productId])
}

// ─── Rol Tabanlı Erişim Kontrolü (RBAC) Modelleri ───

model Role {
  id          String           @id @default(cuid()) @map("role_id")
  name        String           @unique @map("role_name")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid()) @map("permission_id")
  name  String           @unique @map("permission_name")
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

