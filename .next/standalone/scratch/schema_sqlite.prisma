datasource db {
  provider = "sqlite"
  url      = "file:../prisma/dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "./sqlite-client"
}

model Product {
  id                String   @id @default(cuid())
  name              String
  sku               String   @unique
  category          String
  subCategory       String?
  stock             Int      @default(0)
  criticalLimit     Int      @default(10)
  price             Decimal  @default(0)
  oldPrice          Decimal?
  list_price        Decimal? @default(0)
  sale_price        Decimal? @default(0)
  discount_start_date DateTime?
  discount_end_date   DateTime?
  stock_quantity    Int      @default(0)
  isCampaignActive  Boolean  @default(false)
  cartDiscountRate  Float    @default(0)
  cost              Decimal  @default(0)
  image             String
  images            String?  @default("[]")
  desc              String
  seoTitle          String?
  seoDesc           String?
  seoKeywords       String?
  videoUrl          String?
  attributes        String?  @default("{}")
  isRawMaterial     Boolean  @default(false)
  rating            Float    @default(5.0)
  reviews           Int      @default(0)
  isDeleted         Boolean  @default(false)
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  companyId         String?
  b2b_base_price    Decimal? @default(0)
  isDeal            Boolean  @default(false)
  salesCount        Int      @default(0)
}

model CurrentAccount {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("Müşteri")
  taxId        String?
  taxOffice    String?
  phone        String?
  email        String?  @unique
  address      String?
  balance      Decimal  @default(0)
  dealerGroup  String?  @default("Standart")
  priceGroup   String?  @default("Liste")
  riskLimit    Decimal? @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CategoryDetail {
  id         String   @id @default(cuid())
  name       String   @unique
  attributes String?  @default("[]")
  variants   String?  @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
