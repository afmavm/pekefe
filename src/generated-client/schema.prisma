generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated-client"
  engineType    = "wasm"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  taxNo     String?
  taxOffice String?
  domain    String?
  currency  String   @default("TRY")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  products          Product[]
  warehouses        Warehouse[]
  currentAccounts   CurrentAccount[]
  orders            Order[]
  invoices          Invoice[]
  stockTransactions StockTransaction[]
  productionOrders  ProductionOrder[]
  journalEntries    JournalEntry[]
  expenses          Expense[]
  incomes           Income[]
  permissions       CompanyPermission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                           String                        @id @default(cuid())
  name                         String?
  email                        String?                       @unique
  emailVerified                DateTime?
  image                        String?
  password                     String?
  role                         String                        @default("USER")
  isApproved                   Boolean                       @default(false)
  isDeleted                    Boolean                       @default(false)
  companyId                    String?
  company                      Company?                      @relation(fields: [companyId], references: [id])
  accounts                     Account[]
  sessions                     Session[]
  addresses                    Address[]
  branchId                     String?
  branch                       Branch?                       @relation(fields: [branchId], references: [id])
  warehouseId                  String?
  warehouse                    Warehouse?                    @relation(fields: [warehouseId], references: [id])
  purchaseRequisitions         PurchaseRequisition[]
  purchaseRequisitionApprovals PurchaseRequisitionApproval[]
  roles                        UserRole[]

  // B2B Eklemeleri
  customer_type   String    @default("b2c") // "b2c" veya "b2b"
  b2b_group_id    String?
  b2bGroup        B2BGroup? @relation(fields: [b2b_group_id], references: [id])
  company_name    String?
  tax_id          String?
  tax_office      String?
  credit_limit    Decimal?  @default(0.0)
  current_balance Decimal?  @default(0.0)

  @@index([isDeleted])
  @@index([companyId])
  @@index([b2b_group_id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  addressTitle String
  firstName    String
  lastName     String
  phone        String
  city         String
  district     String
  fullAddress  String
  isDefault    Boolean @default(false)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model Product {
  id                  String                @id @default(cuid())
  name                String
  sku                 String                @unique
  category            String
  subCategory         String?
  stock               Float                 @default(0)
  criticalLimit       Float                 @default(0)
  price               Decimal               @default(0.0)
  oldPrice            Decimal?
  list_price          Decimal?              @default(0.0)
  sale_price          Decimal?              @default(0.0)
  discount_start_date DateTime?
  discount_end_date   DateTime?
  stock_quantity      Int?                  @default(0)
  isCampaignActive    Boolean               @default(false)
  cartDiscountRate    Float                 @default(0)
  cost                Decimal               @default(0.0)
  image               String?
  images              Json
  desc                String?
  seoTitle            String?
  seoDesc             String?
  seoKeywords         String?
  videoUrl            String?
  attributes          Json
  isRawMaterial       Boolean               @default(false)
  rating              Float                 @default(5.0)
  reviews             Int                   @default(0)
  isDeleted           Boolean               @default(false)
  version             Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  companyId           String?
  company             Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variants            ProductVariant[]
  usedInRecipes       RecipeItem[]          @relation("Ingredient")
  recipe              RecipeItem[]          @relation("MainProduct")
  locations           StockLocation[]
  stockTransactions   StockTransaction[]
  stockTransfers      StockTransfer[]
  cycleCountItems     StockCycleCountItem[]

  // Yeni İlişkiler
  units                    ProductUnit[]
  productionOrders         ProductionOrder[]
  routeSteps               RouteStep[]
  wasteLogs                WasteLog[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  despatchLines            DespatchLine[]

  // B2B Eklemeleri
  b2b_base_price Decimal?          @default(0.0)
  tieredPricing  TieredPricing[]
  b2bPrices      ProductB2BPrice[]

  // Vitrin / Pazarlama Etiketleri
  isDeal     Boolean @default(false)
  salesCount Int     @default(0)

  @@index([category])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([sku])
  @@index([companyId])
  @@index([isDeal])
  @@index([salesCount])
}

model CategoryDetail {
  id         String  @id @default(cuid())
  name       String  @unique
  parentId   String?
  attributes Json
  variants   Json

  @@index([parentId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  attributes Json
  stock      Float    @default(0)
  price      Decimal?
  sku        String   @unique
  barcode    String?  @unique
  cost       Decimal? @default(0.0)
  product    Product  @relation(fields: [productId], references: [id])

  // Yeni İlişkiler
  locations         StockLocation[]
  stockTransactions StockTransaction[]
  recipeMain        RecipeItem[]       @relation("MainProductVariant")
  recipeIngredient  RecipeItem[]       @relation("IngredientVariant")
  productionOrders  ProductionOrder[]
  wasteLogs         WasteLog[]

  @@index([productId])
  @@index([sku])
}

model StockLocation {
  id               String          @id @default(cuid())
  productId        String
  productVariantId String?
  warehouseId      String
  stock            Float           @default(0)
  reserved         Float           @default(0)
  minStock         Float           @default(0)
  criticalLimit    Float           @default(0)
  rack             String? // Format: "A-01-03" (Blok-Raf-Göz)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouseId])
  @@index([productId, warehouseId])
  @@index([productVariantId])
}

model Warehouse {
  id                String             @id @default(cuid())
  name              String
  code              String             @unique
  type              String
  address           String?
  isActive          Boolean            @default(true)
  isLocked          Boolean            @default(false)
  branchId          String
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations         StockLocation[]
  users             User[]
  transfersFrom     StockTransfer[]    @relation("FromWarehouse")
  transfersTo       StockTransfer[]    @relation("ToWarehouse")
  stockTransactions StockTransaction[]
  cycleCounts       StockCycleCount[]

  // Yeni İlişkiler
  productionOrders         ProductionOrder[]
  wasteLogs                WasteLog[]
  purchaseRequisitionItems PurchaseRequisitionItem[]

  @@index([branchId])
  @@index([companyId])
}

model Branch {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  address              String?
  phone                String?
  isActive             Boolean               @default(true)
  warehouses           Warehouse[]
  users                User[]
  purchaseRequisitions PurchaseRequisition[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model RecipeItem {
  id                   String          @id @default(cuid())
  mainProductId        String
  mainProductVariantId String?
  ingredientId         String
  ingredientVariantId  String?
  quantity             Float
  unit                 String
  ingredient           Product         @relation("Ingredient", fields: [ingredientId], references: [id])
  mainProduct          Product         @relation("MainProduct", fields: [mainProductId], references: [id])
  mainProductVariant   ProductVariant? @relation("MainProductVariant", fields: [mainProductVariantId], references: [id])
  ingredientVariant    ProductVariant? @relation("IngredientVariant", fields: [ingredientVariantId], references: [id])

  @@index([mainProductId])
  @@index([ingredientId])
}

model ProductionOrder {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity         Float
  status           String          @default("Bekliyor") // "Bekliyor"|"ONAYLANDI"|"Tamamlandı"|"İptal"
  date             DateTime        @default(now())
  startDate        DateTime?
  endDate          DateTime?
  productionPlanId String?
  plan             ProductionPlan? @relation(fields: [productionPlanId], references: [id])
  warehouseId      String? // Üretilen mamulün ekleneceği, hammaddelerin düşeceği depo
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])
  approvedBy       String?
  completedBy      String?
  notes            String?
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  wasteLogs        WasteLog[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@index([productId])
  @@index([status])
  @@index([date])
  @@index([companyId])
}

model CurrentAccount {
  id       String  @id @default(cuid())
  cariKod  String? @unique // Cari Kodu
  name     String // Kurumsal için firma ünvanı, bireysel için ad-soyad
  type     String  @default("MUSTERI") // Roller (virgülle ayrılmış veya ilişkisel)
  cariTipi String  @default("CORPORATE") // "INDIVIDUAL" (B2C) veya "CORPORATE" (B2B)

  // B2C (Bireysel) Alanlar
  ad          String?
  soyad       String?
  tckn        String?   @unique
  dogumTarihi DateTime?

  // B2B (Kurumsal) Alanlar
  taxNo       String?
  taxId       String?
  taxOffice   String?
  mersisNo    String?
  yetkiliKisi String?
  webSitesi   String?

  // İletişim Bilgileri
  phone   String?
  email   String? @unique
  address String?

  // Finansal Limitler ve B2B Parametreleri
  balance               Decimal          @default(0.0)
  currency              String           @default("TRY")
  openingBalance        Decimal          @default(0.0)
  isActive              Boolean          @default(true)
  isDeleted             Boolean          @default(false)
  discountRate          Float?
  creditLimit           Decimal?
  riskLimit             Decimal?
  vadeGun               Int?
  b2bMinQty             Float?           @default(1)
  b2bPaymentTerms       String?          @default("Nakit")
  b2bCode               String?
  loyaltyPoints         Float            @default(0)
  dealerGroup           String           @default("Standart")
  priceGroup            String           @default("Liste")
  priceFormula          String?
  parentDealerId        String?
  kaynakPlatform        String           @default("ATAK_B2B")
  eFaturaDurumu         Boolean          @default(false)
  blokeDurumu           Boolean          @default(false)
  adresler              Json?
  entegrasyonHaritalama Json?
  auditLogs             Json?
  dosyalar              Json?
  bankalar              Json?
  kvkk                  Json?
  yetkililer            Json?
  tanimlar              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  companyId             String?
  company               Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices              Invoice[]
  orders                Order[]
  subAccounts           SubAccount[]
  transactions          Transaction[]
  despatchAdvices       DespatchAdvice[]

  @@index([type])
  @@index([isActive])
  @@index([isDeleted])
  @@index([parentDealerId])
  @@index([companyId])
  @@map("cariler")
}

model SubAccount {
  id               String         @id @default(cuid())
  currentAccountId String
  name             String
  email            String         @unique
  phone            String?
  role             String
  balance          Decimal        @default(0.0)
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id])

  @@index([currentAccountId])
}

model Transaction {
  id               String         @id @default(cuid())
  currentAccountId String
  subAccountId     String?
  date             DateTime       @default(now())
  type             String
  amount           Decimal
  description      String
  paymentMethod    String?
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id])

  @@index([currentAccountId])
  @@index([date])
}

model Invoice {
  id               String           @id @default(cuid())
  orderId          String?
  currentAccountId String
  date             DateTime         @default(now())
  dueDate          DateTime
  totalAmount      Decimal
  taxAmount        Decimal
  status           String
  type             String
  externalLink     String?
  items            Json
  notes            String?
  isDeleted        Boolean          @default(false)
  stockMovement    Boolean          @default(false) @map("stock_movement")
  companyId        String?
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceItems     InvoiceItem[]
  currentAccount   CurrentAccount   @relation(fields: [currentAccountId], references: [id], onDelete: Cascade)
  despatchAdvices  DespatchAdvice[]
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([currentAccountId])
  @@index([status])
  @@index([date])
  @@index([isDeleted])
  @@index([companyId])
  @@index([orderId])
}

model Bank {
  id            String  @id @default(cuid())
  name          String
  accountNumber String
  iban          String
  balance       Decimal @default(0.0)
  currency      String  @default("TRY")
  logo          String?
  branch        String?
  type          String  @default("VADESIZ")
}

model Order {
  id               String           @id @default(cuid())
  currentAccountId String
  date             DateTime         @default(now())
  status           String
  total            Decimal
  shippingFee      Decimal          @default(0.0)
  summary          String?
  type             String           @default("B2C")
  method           String?
  isDeleted        Boolean          @default(false)
  companyId        String?
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currentAccount   CurrentAccount   @relation(fields: [currentAccountId], references: [id], onDelete: Cascade)
  despatchAdvices  DespatchAdvice[]
  invoices         Invoice[]

  @@index([status])
  @@index([date])
  @@index([currentAccountId])
  @@index([isDeleted])
  @@index([companyId])
}

