model CMSPage {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Integration {
  id       String  @id @default(cuid())
  name     String
  type     String
  status   String
  lastSync String?
  logo     String
  settings Json
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String
  time          String
  message       String
  status        String
  createdAt     DateTime @default(now())

  @@index([integrationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK TRANSACTION — Kurumsal Audit Log
// ─────────────────────────────────────────────────────────────────────────────
model StockTransaction {
  id               String          @id @default(cuid())
  productId        String
  productVariantId String?
  warehouseId      String?
  type             String // "IN"|"OUT"|"TRANSFER_OUT"|"TRANSFER_IN"|"PRODUCTION_IN"|"PRODUCTION_OUT"|"RETURN"|"SALE"|"CYCLE_SURPLUS"|"CYCLE_DEFICIT"
  quantity         Float
  unitCost         Decimal? // Birim maliyet (FIFO/AOM için)
  remainingQty     Float? // FIFO/LIFO için kalan miktar
  description      String?
  date             DateTime        @default(now())
  userId           String? // Hangi kullanıcı
  userEmail        String? // Kullanıcı e-posta
  moduleSource     String?         @default("MANUAL") // "MANUAL"|"API"|"MARKETPLACE"|"TRANSFER"|"CYCLE_COUNT"|"PRODUCTION"
  ipAddress        String? // İstemci IP
  referenceId      String? // İlgili transfer/sayım ID
  metadata         Json? // Ek JSON detayları
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id])
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([date])
  @@index([type])
  @@index([moduleSource])
  @@index([productVariantId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK TRANSFER — In-Transit Workflow
// ─────────────────────────────────────────────────────────────────────────────
model StockTransfer {
  id              String    @id @default(cuid())
  transferNo      String    @unique @default(cuid())
  productId       String
  fromWarehouseId String
  toWarehouseId   String
  quantity        Float
  status          String    @default("Taslak") // "Taslak"|"Yolda"|"Tamamlandı"|"Reddedildi"
  requester       String?
  approvedBy      String?
  rejectionReason String?
  notes           String?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         Product   @relation(fields: [productId], references: [id])
  fromWarehouse   Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse     Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK CYCLE COUNT — Sayım İşlemleri
// ─────────────────────────────────────────────────────────────────────────────
model StockCycleCount {
  id          String                @id @default(cuid())
  code        String                @unique // SAYIM-2026-001
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  type        String // "GENEL"|"KISMI"|"BARKODLU"
  status      String                @default("TASLAK") // "TASLAK"|"DEVAM_EDIYOR"|"TAMAMLANDI"|"IPTAL"
  isLocked    Boolean               @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdBy   String?
  items       StockCycleCountItem[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([warehouseId])
  @@index([status])
}

model StockCycleCountItem {
  id           String          @id @default(cuid())
  cycleCountId String
  cycleCount   StockCycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  systemStock  Float
  countedStock Float?
  difference   Float?
  rack         String?
  notes        String?

  @@index([cycleCountId])
  @@index([productId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Float
  minCartAmount Float     @default(0)
  maxUses       Int?
  uses          Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([code])
}

model Ticket {
  id        String          @id @default(cuid())
  email     String
  subject   String
  status    String          @default("OPEN")
  category  String          @default("GENERAL")
  orderId   String?
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String
  message   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        String   @default("percentage")
  value       Float    @default(0)
  minOrder    Float    @default(0)
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  startDate   String
  endDate     String
  isActive    Boolean  @default(true)
  target      String   @default("all")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  rating    Int
  message   String
  status    String   @default("PENDING")
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String   @default("Genel")
  image     String?
  metaDesc  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model AccountingAccount {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  type        String
  parentCode  String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")

  @@index([code])
}

model JournalEntry {
  id          String        @id @default(cuid())
  date        DateTime      @default(now())
  number      String        @unique
  description String
  status      String        @default("DRAFT")
  type        String        @default("GENERAL")
  createdBy   String?
  referenceId String?
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([date])
  @@index([number])
  @@index([companyId])
}

model JournalLine {
  id              String            @id @default(cuid())
  journalEntry    JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId  String
  debitAccount    AccountingAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  debitAccountId  String
  creditAccount   AccountingAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])
  creditAccountId String
  amount          Decimal
  description     String?

  @@index([journalEntryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

model Expense {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  category      String
  amount        Decimal
  taxAmount     Decimal  @default(0.0)
  description   String
  supplier      String?
  receiptNo     String?
  paymentMethod String   @default("NAKIT")
  bankId        String?
  status        String   @default("ODENDI")
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([companyId])
}

model BudgetItem {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  category  String
  planned   Decimal
  actual    Decimal  @default(0.0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, category])
}

model TaxDeclaration {
  id        String    @id @default(cuid())
  period    String
  type      String
  amount    Decimal
  taxBase   Decimal?
  taxRate   Float?
  status    String    @default("BEKLIYOR")
  dueDate   DateTime
  paidDate  DateTime?
  paidAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([period])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  quantity    Float
  unitPrice   Decimal
  vatRate     Float   @default(18)
  totalAmount Decimal

  @@index([invoiceId])
}

model Income {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  category         String
  amount           Decimal
  taxAmount        Decimal  @default(0.0)
  description      String
  currentAccountId String?
  paymentMethod    String   @default("HAVALE")
  bankId           String?
  status           String   @default("ALINDI")
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([companyId])
}

model AuthLog {
  id         String   @id @default(cuid())
  ip         String
  userId     String?
  route      String
  method     String
  failReason String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model MediaItem {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  size      String
  tag       String   @default("general")
  alt       String   @default("")
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// YENİ ERP MODÜLLERİ: PLANLAMA, BİRİM, İSTASYON VE FİRE MODELLERİ
// ─────────────────────────────────────────────────────────────────────────────

model ProductUnit {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // Örn: "Koli", "Paket", "kg", "Adet"
  factor    Float // Örn: 12 (1 Koli = 12 Adet)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductionPlan {
  id        String            @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    String            @default("TASLAK") // "TASLAK"|"ONAYLANDI"|"TAMAMLANDI"|"IPTAL"
  orders    ProductionOrder[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Workstation {
  id        String      @id @default(cuid())
  name      String
  code      String      @unique
  capacity  Float       @default(100)
  unit      String      @default("SAAT")
  isActive  Boolean     @default(true)
  steps     RouteStep[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model RouteStep {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stepNumber    Int
  name          String
  workstationId String
  workstation   Workstation @relation(fields: [workstationId], references: [id])
  setupTime     Float       @default(0)
  runTime       Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
  @@index([workstationId])
}

model WasteLog {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  productVariantId  String?
  variant           ProductVariant?  @relation(fields: [productVariantId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  warehouseId       String
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id])
  quantity          Float
  reason            String
  date              DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([productId])
  @@index([warehouseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PURCHASE REQUISITION — Satın Alma Talepleri Modelleri
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseRequisition {
  id                   String                        @id @default(cuid())
  requisitionNo        String                        @unique
  requestDate          DateTime                      @default(now())
  branchId             String
  branch               Branch                        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId         String
  requesterId          String
  requester            User                          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  projectId            String?
  costCenterId         String?
  priority             String                        @default("Normal") // "Düşük", "Normal", "Yüksek", "Kritik"
  status               String                        @default("Taslak") // "Taslak", "Onay Bekliyor", "Onaylandı", "Reddedildi", "Teklife Aktarıldı", "Siparişe Aktarıldı", "Tamamlandı", "İptal"
  approvalStatus       String                        @default("Bekliyor") // "Bekliyor", "Onaylandı", "Reddedildi", "Revizyon"
  expectedDeliveryDate DateTime
  totalAmount          Decimal                       @default(0.0)
  notes                String?
  items                PurchaseRequisitionItem[]
  approvals            PurchaseRequisitionApproval[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([status])
  @@index([priority])
  @@index([requesterId])
  @@index([branchId])
}

model PurchaseRequisitionItem {
  id            String              @id @default(cuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity      Float
  unitPrice     Decimal
  totalPrice    Decimal
  description   String?

  @@index([requisitionId])
  @@index([productId])
}

model PurchaseRequisitionApproval {
  id            String              @id @default(cuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approverId    String
  approver      User                @relation(fields: [approverId], references: [id], onDelete: Cascade)
  action        String // "Onayla", "Reddet", "Revizyona Gönder", "Yorum Ekle"
  comment       String?
  approvalDate  DateTime            @default(now())

  @@index([requisitionId])
  @@index([approverId])
}

model DespatchAdvice {
  id                 String   @id @default(uuid()) @map("despatch_id")
  despatchNo         String   @unique @map("despatch_no")
  ettnNo             String   @unique @default(uuid()) @map("ettn_no")
  customerAccountId  String   @map("customer_id")
  invoiceId          String?  @map("invoice_id")
  orderId            String?  @map("order_id")
  issueDate          DateTime @map("issue_date")
  actualDespatchDate DateTime @map("actual_despatch_date")
  carrierId          String?  @map("carrier_id")
  driverName         String?  @map("driver_name")
  driverIdentityNo   String?  @map("driver_identity_no")
  licensePlate       String?  @map("license_plate")
  status             String   @map("status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  customerAccount CurrentAccount @relation(fields: [customerAccountId], references: [id])
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines           DespatchLine[]

  @@index([customerAccountId])
  @@index([invoiceId])
  @@index([orderId])
  @@map("despatch_advices")
}

model DespatchLine {
  id         String   @id @default(uuid()) @map("line_id")
  despatchId String   @map("despatch_id")
  productId  String   @map("stock_id")
  quantity   Float    @map("quantity")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  despatchAdvice DespatchAdvice @relation(fields: [despatchId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([despatchId])
  @@index([productId])
  @@map("despatch_lines")
}

// ─── Rol Tabanlı Erişim Kontrolü (RBAC) Modelleri ───

model Role {
  id          String           @id @default(cuid()) @map("role_id")
  name        String           @unique @map("role_name")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid()) @map("permission_id")
  name  String           @unique @map("permission_name")
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model SystemAuditLog {
  id        String   @id @default(uuid())
  tableName String
  recordId  String
  action    String
  oldData   Json?
  newData   Json?
  userId    String?
  companyId String?
  createdAt DateTime @default(now())

  @@index([tableName])
  @@index([recordId])
  @@index([action])
  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}

// ─── B2B (Bayi/Kurumsal) Modelleri ───

model B2BGroup {
  id                 String            @id @default(cuid())
  group_name         String            @unique // Örn: "Toptancı 1"
  base_discount_rate Float             @default(0) // Temel iskonto oranı (örn: 15 -> %15)
  users              User[]
  tieredPricing      TieredPricing[]
  b2bPrices          ProductB2BPrice[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("b2b_groups")
}

model ProductB2BPrice {
  id         String   @id @default(cuid())
  productId  String
  b2bGroupId String
  price      Decimal // B2B Grubu için özel taban fiyat
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  b2bGroup   B2BGroup @relation(fields: [b2bGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, b2bGroupId])
  @@index([productId])
  @@index([b2bGroupId])
  @@map("product_b2b_prices")
}

model TieredPricing {
  id                  String   @id @default(cuid())
  productId           String
  b2bGroupId          String
  min_quantity        Int // Minimum alım adedi (örn: 10)
  discount_percentage Float // Uygulanacak indirim yüzdesi (örn: 5 -> %5)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  b2bGroup            B2BGroup @relation(fields: [b2bGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, b2bGroupId, min_quantity])
  @@index([productId])
  @@index([b2bGroupId])
  @@map("tiered_pricings")
}

model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("ORDER") // ORDER, TICKET, etc.
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  orderId   String?

  @@map("admin_notifications")
}

model FeatureModule {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "b2b", "b2c", "production", "inventory", "accounting"
  name        String // e.g. "B2B Bayi Portalı", "B2C E-Ticaret", "Üretim / MRP", "Depo / Stok", "Muhasebe"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions CompanyPermission[]

  @@map("features_modules")
}

model CompanyPermission {
  id              String   @id @default(cuid())
  companyId       String
  featureModuleId String
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  featureModule FeatureModule @relation(fields: [featureModuleId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureModuleId])
  @@index([companyId])
  @@index([featureModuleId])
  @@map("company_permissions")
}

model FailedCargoRequest {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  carrierName    String   @map("carrier_name")
  requestPayload String   @map("request_payload")
  errorMessage   String?  @map("error_message")
  retryCount     Int      @default(0) @map("retry_count")
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("failed_cargo_requests")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  eventType String   @unique @map("event_type")
  name      String
  subject   String
  bodyHtml  String   @map("body_html")
  variables String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model EmailLog {
  id           String   @id @default(uuid())
  recipient    String
  subject      String
  bodyHtml     String   @map("body_html")
  eventType    String?  @map("event_type")
  status       String
  errorMessage String?  @map("error_message")
  retryCount   Int      @default(0) @map("retry_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("email_logs")
}
